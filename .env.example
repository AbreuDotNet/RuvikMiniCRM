# ---------------------------------------------------------------------------
# Ruvik configuration
#
# Every value here is read and validated once at boot (apps/api/src/config/env.ts).
# In production, secrets come from a secrets manager and are injected as env
# vars — this file documents the shape, it is never the source of truth.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=info

# --------------------------------------------------------------- database ---
# Unset: the API runs on embedded PostgreSQL (PGlite) with no server to
# install — the default for local development and CI.
# Set: any PostgreSQL 15+ instance. The SQL is identical either way.
# DATABASE_URL=postgres://ruvik:password@localhost:5432/ruvik
PGLITE_DIR=.data/pglite
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------ cache ---
# Unset: an in-process cache backs rate limiting and caching (single node).
# Set: Redis, required once you run more than one API instance.
# REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------- security ---
# REQUIRED in production — the process refuses to boot without them.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
HASH_PEPPER=
BILLING_WEBHOOK_SECRET=

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
RATE_LIMIT_ENABLED=true
# Number of proxy hops to trust for the client IP. Set this to match your
# load balancer exactly: too high and a client can spoof its IP past the
# rate limiter.
TRUST_PROXY=1

# ---------------------------------------------------------------- storage ---
STORAGE_DRIVER=local
STORAGE_DIR=storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=8388608
MAX_JSON_BYTES=262144
# S3_BUCKET=
# S3_REGION=

# --------------------------------------------------------------- WhatsApp ---
# Official WhatsApp Business Platform (Cloud API) only.
# Left false, the platform simulates sends so the full consent, queue,
# status-log and fallback path is exercisable without contacting Meta.
WHATSAPP_ENABLED=false
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------- workers ---
# in-process (default) runs workers inside the API — fine for one node.
# external runs `npm run worker` as its own scalable process.
# WORKER_MODE=external
