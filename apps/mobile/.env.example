# Where the Ruvik API lives. Must include the scheme and no trailing slash.
#
# Leave it unset in development and the app derives the host from the Expo dev
# server (see src/services/config.ts): a physical device then reaches your
# laptop over the LAN with no edit here, which is the case that otherwise
# wastes an afternoon.
#
# Set it explicitly when pointing at staging or production.
# EXPO_PUBLIC_API_URL=https://api.ruvik.example

# Port the API listens on locally. Only used by the dev-host fallback above.
EXPO_PUBLIC_API_PORT=4000
