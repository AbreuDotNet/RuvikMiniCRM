{
  "expo": {
    "name": "Ruvik",
    "slug": "ruvik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ruvik",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#3C5A7D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ruvik.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ruvik.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#3C5A7D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3C5A7D",
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#3C5A7D",
            "image": "./assets/splash-mark.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ruvik uses your photos so you can add work pictures to your profile and jobs."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D57E5F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
